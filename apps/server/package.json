{
  "name": "@teamtown/server",
  "version": "0.0.0",
  "private": true,
  "description": "TeamTown server: NestJS modular monolith (REST + realtime gateway).",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsup --watch --onSuccess \"node --env-file=.env.development --enable-source-maps --import ./dist/instrumentation.js dist/main.js\"",
    "build": "tsup",
    "start": "node --enable-source-maps --import ./dist/instrumentation.js dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation": "^0.300.0",
    "@opentelemetry/instrumentation-http": "^0.300.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-pino": "^0.70.0",
    "@opentelemetry/resources": "^3.0.0",
    "@opentelemetry/sdk-logs": "^3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
