    "import-in-the-middle": "3.5.3",
    "jose": "^6.2.13",
    "nestjs-pino": "^5.3.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@swc/core": "^1.16.20",
    "@teamtown/config": "workspace:*",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/ws": "^8.18.2",
    "tsup": "^9.0.0",
    "unplugin-swc": "^2.0.0"
