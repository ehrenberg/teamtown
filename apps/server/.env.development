# Local development configuration, matching docker/compose.dev.yml. Not used in production.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://teamtown:teamtown@localhost:5432/teamtown
DATABASE_MIGRATE_ON_START=true
OIDC_ISSUER=http://localhost:8080/realms/teamtown
OIDC_AUDIENCE=teamtown-api
LOG_LEVEL=info
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=teamtown-server
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
