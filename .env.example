# TeamTown server configuration (validated at startup, see apps/server/src/platform/config/app-config.ts).
# Copy to .env for local overrides. Never commit real secrets.

# development | test | production
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# PostgreSQL connection (required)
DATABASE_URL=postgres://teamtown:teamtown@localhost:5432/teamtown
# Apply pending migrations on startup (true | false)
DATABASE_MIGRATE_ON_START=true

# OpenID Connect (required): issuer of the access tokens and the audience they must contain
OIDC_ISSUER=http://localhost:8080/realms/teamtown
OIDC_AUDIENCE=teamtown-api

# LiveKit (ADR-0008): audio for proximity conversations. Leave empty to run without audio.
# LIVEKIT_URL is what clients connect to; LIVEKIT_API_URL is the server API as reached from this server.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Logs: structured JSON on stdout (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info

# OpenTelemetry (ADR-0019): traces, metrics and logs go to the instance's own collector.
# Leave the endpoint empty to switch telemetry off. Standard OpenTelemetry variables apply.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=teamtown-server

# Web client dev server: where /api requests are proxied to.
TEAMTOWN_SERVER_URL=http://localhost:3000

# Desktop app (development): which web client URL the Electron shell loads.
TEAMTOWN_WEB_URL=http://localhost:5173
