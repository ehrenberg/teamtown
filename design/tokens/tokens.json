{
  "$description": "TeamTown design tokens (W3C Design Tokens format). Core palette decided 2026-10-29; scales, semantic mapping and sizes are proposals.",
  "color": {
    "espresso": { "$type": "color", "$value": "#2B1F1A", "$description": "Core: primary text, dark surfaces" },
    "terracotta": {
      "100": { "$type": "color", "$value": "#F8DED3" },
      "300": { "$type": "color", "$value": "#E9967A" },
      "400": { "$type": "color", "$value": "#E27A52" },
      "500": { "$type": "color", "$value": "#D9653B", "$description": "Core: brand primary" },
      "700": { "$type": "color", "$value": "#B54D2A", "$description": "AA on cream; buttons, links" },
      "900": { "$type": "color", "$value": "#7A3018" }
    },
    "sage": {
      "100": { "$type": "color", "$value": "#E3EEE5" },
      "500": { "$type": "color", "$value": "#8FB59A", "$description": "Core: freshness, available" },
      "600": { "$type": "color", "$value": "#5F9470" },
      "700": { "$type": "color", "$value": "#4F7A5C", "$description": "AA on cream" }
    },
    "ocean": {
      "100": { "$type": "color", "$value": "#D6E6EE" },
      "500": { "$type": "color", "$value": "#2F6F8F", "$description": "Core: secondary, info, focus status" },
      "700": { "$type": "color", "$value": "#22546C" }
    },
    "ochre": {
      "100": { "$type": "color", "$value": "#FAEBCB" },
      "500": { "$type": "color", "$value": "#E8B04A", "$description": "Core: highlights, warm light" },
      "700": { "$type": "color", "$value": "#9A6B12" }
    },
    "cream": { "$type": "color", "$value": "#FBF6EE", "$description": "Core: main background" },
    "neutral": {
      "50":  { "$type": "color", "$value": "#FBF6EE" },
      "100": { "$type": "color", "$value": "#F3ECE1" },
      "200": { "$type": "color", "$value": "#E6DCCD" },
      "300": { "$type": "color", "$value": "#CFC2B0" },
      "400": { "$type": "color", "$value": "#A89A88" },
      "500": { "$type": "color", "$value": "#857767" },
      "600": { "$type": "color", "$value": "#66594C" },
      "700": { "$type": "color", "$value": "#4A3F36" },
      "800": { "$type": "color", "$value": "#352B24" },
      "900": { "$type": "color", "$value": "#2B1F1A" }
    },
    "white": { "$type": "color", "$value": "#FFFFFF" }
  },
  "semantic": {
    "surface": {
      "canvas":   { "$type": "color", "$value": "{color.cream}" },
      "raised":   { "$type": "color", "$value": "{color.white}" },
      "sunken":   { "$type": "color", "$value": "{color.neutral.100}" },
      "inverse":  { "$type": "color", "$value": "{color.espresso}" }
    },
    "text": {
      "primary":   { "$type": "color", "$value": "{color.espresso}" },
      "secondary": { "$type": "color", "$value": "{color.neutral.600}" },
      "disabled":  { "$type": "color", "$value": "{color.neutral.400}" },
      "inverse":   { "$type": "color", "$value": "{color.cream}" },
      "link":      { "$type": "color", "$value": "{color.ocean.500}" }
    },
    "action": {
      "primary":        { "$type": "color", "$value": "{color.terracotta.700}" },
      "primary-hover":  { "$type": "color", "$value": "{color.terracotta.900}" },
      "secondary":      { "$type": "color", "$value": "{color.neutral.100}" },
      "focus-ring":     { "$type": "color", "$value": "{color.terracotta.700}" }
    },
    "border": {
      "subtle":  { "$type": "color", "$value": "{color.neutral.200}" },
      "strong":  { "$type": "color", "$value": "{color.neutral.300}" }
    },
    "status": {
      "available":  { "$type": "color", "$value": "{color.sage.600}" },
      "busy":       { "$type": "color", "$value": "{color.terracotta.500}" },
      "focus":      { "$type": "color", "$value": "{color.ocean.500}" },
      "away":       { "$type": "color", "$value": "{color.ochre.500}" },
      "offline":    { "$type": "color", "$value": "{color.neutral.400}" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Outfit", "system-ui", "sans-serif"] },
      "body":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] },
      "mono":    { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "monospace"] }
    },
    "size": {
      "xs":  { "$type": "dimension", "$value": "0.75rem" },
      "sm":  { "$type": "dimension", "$value": "0.875rem" },
      "md":  { "$type": "dimension", "$value": "1rem" },
      "lg":  { "$type": "dimension", "$value": "1.125rem" },
      "xl":  { "$type": "dimension", "$value": "1.375rem" },
      "2xl": { "$type": "dimension", "$value": "1.75rem" },
      "3xl": { "$type": "dimension", "$value": "2.25rem" },
      "4xl": { "$type": "dimension", "$value": "3rem" }
    }
  },
  "radius": {
    "sm":   { "$type": "dimension", "$value": "6px" },
    "md":   { "$type": "dimension", "$value": "10px" },
    "lg":   { "$type": "dimension", "$value": "16px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "12": { "$type": "dimension", "$value": "48px" }
  },
  "shadow": {
    "raised": { "$type": "shadow", "$value": "0 1px 2px rgb(43 31 26 / 0.08), 0 8px 24px rgb(43 31 26 / 0.08)" }
  },
  "motion": {
    "duration": {
      "fast":   { "$type": "duration", "$value": "150ms" },
      "normal": { "$type": "duration", "$value": "250ms" }
    },
    "easing": {
      "out": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
    }
  }
}
