{
  "realm": "teamtown",
  "displayName": "TeamTown",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "internationalizationEnabled": true,
  "supportedLocales": ["en", "de"],
  "defaultLocale": "en",
  "clients": [
    {
      "clientId": "teamtown-web",
      "name": "TeamTown web client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*"],
      "webOrigins": ["http://localhost:5173"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "teamtown-desktop",
      "name": "TeamTown desktop app (system browser + deep link, ADR-0023)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["teamtown://auth/callback"],
      "attributes": { "pkce.code.challenge.method": "S256" }
    }
  ],
  "users": [
    {
      "username": "demo",
      "email": "demo@teamtown.local",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "demo", "temporary": false }]
    }
  ]
}
